{
    "name": "licorice19/laravel-backup",
    "type": "library",
    "description": "Laravel package for database and files backup with restore functionality",
    "keywords": ["laravel", "backup", "database", "restore", "mysql", "sqlite"],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Licorice19\\Backup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Licorice19\\Backup\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Dmitry K.",
            "email": "dkozyarskij@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "ifsnop/mysqldump-php": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "pestphp/pest": "^2.0|^3.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "laravel/pint": "^1.10"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Licorice19\\Backup\\BackupServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest",
        "test-coverage": "pest --coverage",
        "pint": "pint",
        "pint-test": "pint --test"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}